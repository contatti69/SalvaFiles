{
  "name": "jan-extension-salva-files",
  "version": "1.0.0",
  "description": "Estensione per Jan che permette di salvare file prodotti nella chat in una cartella locale",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "npm run build && npm pack",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "jan",
    "extension",
    "files",
    "save",
    "share"
  ],
  "author": "Il tuo nome",
  "license": "MIT",
  "dependencies": {
    "@janhq/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "jan": {
    "type": "extension",
    "displayName": "SalvaFiles",
    "description": "Salva e condividi i file prodotti durante la chat"
  },
  "files": [
    "dist/**/*"
  ]
}
